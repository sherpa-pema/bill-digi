# ==============================================================================
# SanoBill (.htaccess) - Hostinger / LiteSpeed / Apache Production Configuration
# Domain: https://www.sanobill.com
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS connection
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Canonical redirect: sanobill.com -> www.sanobill.com
  RewriteCond %{HTTP_HOST} ^sanobill\.com$ [NC]
  RewriteRule ^(.*)$ https://www.sanobill.com/$1 [L,R=301]

  # 3. Single Page Application (SPA) routing fallback
  # Allow direct requests to existing files and directories (assets, images, scripts)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Route all other URLs (e.g., /billshare, /admin) to index.html
  RewriteRule . /index.html [L]
</IfModule>

# 4. Performance & Browser Caching Headers
<IfModule mod_headers.c>
  # Long-term cache for hashed Vite assets & static images (1 year)
  <FilesMatch "\.(?:js|mjs|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Prevent caching of index.html so updates/new builds are immediately picked up
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Modern Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# 5. Gzip Compression for faster page loads
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
